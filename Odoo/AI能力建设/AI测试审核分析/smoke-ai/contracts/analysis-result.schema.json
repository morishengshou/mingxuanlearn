{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalysisResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "category",
    "proposed_verdict",
    "confidence",
    "summary",
    "evidence",
    "matched_issue_id",
    "alternative_hypotheses",
    "missing_evidence",
    "recommended_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "category": {
      "enum": [
        "PRODUCT_DEFECT",
        "TEST_DEFECT",
        "ENVIRONMENT",
        "INFRASTRUCTURE",
        "UNKNOWN"
      ]
    },
    "proposed_verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NEEDS_REVIEW",
        "NOT_TESTED"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "evidence": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "line_start",
          "line_end",
          "excerpt_hash",
          "supports"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "excerpt_hash": {
            "type": "string",
            "minLength": 1
          },
          "supports": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "matched_issue_id": {
      "type": ["string", "null"]
    },
    "alternative_hypotheses": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "missing_evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "recommended_actions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  }
}